APP_NAME=ChatCo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatco
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

FILESYSTEM_DISK=local

# Queue — sync for testing, database for dev, redis for production
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail (SMTP) ─────────────────────────────────────────────────────
# For Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls
# Create a Gmail App Password: Google Account → Security → 2-FA → App Passwords
# For SendGrid: MAIL_HOST=smtp.sendgrid.net, MAIL_PORT=587, MAIL_USERNAME=apikey, MAIL_PASSWORD=your_key
# For Mailgun: MAIL_HOST=smtp.mailgun.org, MAIL_PORT=587
# For Brevo (Sendinblue): MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587,
#   MAIL_USERNAME=<brevo smtp login>, MAIL_PASSWORD=<brevo smtp key>, MAIL_SCHEME=null
#   (works through the built-in SMTP mailer — no extra package required)
# Default: MAIL_MAILER=log (writes emails to laravel.log — no SMTP needed for dev)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@chatco.local"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo SMTP credentials (leave blank until provisioned). To activate: set
# MAIL_MAILER=smtp and the Brevo MAIL_HOST/PORT/USERNAME/PASSWORD above.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# ─── Registration rejection safety net ───────────────────────────────
# After REGISTRATION_REJECTION_THRESHOLD rejections of the same email/contact,
# re-registration is paused for REGISTRATION_COOLDOWN_DAYS days.
REGISTRATION_REJECTION_THRESHOLD=3
REGISTRATION_COOLDOWN_DAYS=3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ─── Payments (provider-agnostic; see config/payments.php) ────────────
# Which gateway settles online (GCash) payments. If the selected gateway is
# not configured (no keys), the app transparently falls back to the "fake"
# gateway so the flow still works without credentials.
PAYMENT_GATEWAY=paymongo
# DEV ONLY: enables POST /payments/{id}/simulate to drive a PENDING GCash
# payment to PAID/FAILED without a real provider. MUST be false in production.
# Defaults to APP_DEBUG when unset.
PAYMENT_ALLOW_SIMULATION=true
# Where the payer is redirected after authorizing on the provider's page.
# Must point at the FRONTEND (Next.js :3000), not the backend — the
# /gcash/return page reads ?transaction_id from the query string and polls.
PAYMENT_RETURN_URL=http://localhost:3000/gcash/return

# Minutes a conductor-generated GCash binding QR stays claimable.
#
# Covers the FULL real-world flow: QR generation → commuter scan → PayMongo
# redirect → GCash login + OTP → authorize → PayMongo webhook. Real-world
# timing often exceeds 5 minutes on slow mobile connections, and PayMongo's
# own settlement can lag the authorize click by 10-30s.
#
# Set to 10 to comfortably accommodate the worst case. Setting this too low
# causes the transaction to flip to EXPIRED *while* the commuter is still on
# PayMongo's authorize page — the late webhook still settles the payment
# (EXPIRED→PAID is allowed by the state machine), but the conductor UI will
# have already shown "expired" and stopped polling, missing the resolution.
PAYMENT_GCASH_CLAIM_TTL=10

# Seconds the status-poll endpoint waits between PayMongo API reconciliations
# (rate-limits provider round-trips per transaction; 0 disables reconciliation).
PAYMENT_RECONCILE_TTL=30
# Seconds to keep polling AFTER a transaction flips to EXPIRED, to catch a
# late PayMongo webhook that triggers the EXPIRED→PAID transition.
PAYMENT_LATE_SETTLEMENT_GRACE=60

# ─── PayMongo gateway (GCash SANDBOX / LIVE) ──────────────────────────
# Get these from https://dashboard.paymongo.com/developers/api-keys
# Sandbox keys start with sk_test_ ; live keys start with sk_live_.
# The ONLY differences between sandbox and live are the key and the
# authorize page UI -- no code change needed to switch.
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret — from the PayMongo dashboard → Developers → Webhooks
# (create a webhook pointing at your public backend URL: https://<host>/api/v1/payments/webhook).
# Without this exact secret, signature verification fails and every webhook
# returns 400 → the commuter's payment authorizes on PayMongo but never
# settles in CHATCO. Local dev requires ngrok (or similar) exposing :8000.
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
