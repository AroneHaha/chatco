APP_NAME=ChatCo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatco
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

FILESYSTEM_DISK=local

# Queue — sync for testing, database for dev, redis for production
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ─── Payments (provider-agnostic; see config/payments.php) ────────────
# Which gateway settles online (GCash) payments. If the selected gateway is
# not configured (no keys), the app transparently falls back to the "fake"
# gateway so the flow still works without credentials.
PAYMENT_GATEWAY=paymongo
# DEV ONLY: enables POST /payments/{id}/simulate to drive a PENDING GCash
# payment to PAID/FAILED without a real provider. MUST be false in production.
# Defaults to APP_DEBUG when unset.
PAYMENT_ALLOW_SIMULATION=true
# Where the payer is redirected after authorizing on the provider's page.
PAYMENT_RETURN_URL=http://localhost:3000/gcash/return
# Minutes a conductor-generated GCash binding QR stays claimable.
PAYMENT_GCASH_CLAIM_TTL=5

# ─── PayMongo gateway (GCash SANDBOX / LIVE) ──────────────────────────
# Get these from https://dashboard.paymongo.com/developers/api-keys
# Sandbox keys start with sk_test_ ; live keys start with sk_live_.
# The ONLY differences between sandbox and live are the key and the
# authorize page UI -- no code change needed to switch.
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsk_posozQKeZYm13cKCNtohjBar
