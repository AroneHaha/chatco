# ─── API ─────────────────────────────────────────────────────────────
# Base URL for the Laravel API gateway. Must match the backend's APP_URL
# (set in backend/.env.example). Include the /api/v1 suffix — the
# frontend API client concatenates endpoint paths onto this base. The
# /v1 version prefix is set in backend/bootstrap/app.php via
# apiPrefix: 'api/v1' and applies to all routes in routes/api.php.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Real-Time Broadcasting (Pusher) ─────────────────────────────────
# Sprint 2 — Laravel Echo + Pusher. The frontend subscribes to the
# `vehicles` channel for live GPS updates. Keys come from your Pusher
# dashboard (https://dashboard.pusher.io). Use placeholder values here —
# NEVER commit real credentials.
NEXT_PUBLIC_PUSHER_APP_KEY=your_app_key
NEXT_PUBLIC_PUSHER_APP_CLUSTER=ap1

# ─── Conductor API Mode (optional) ───────────────────────────────────
# When set to "local", the conductor UI runs entirely against in-browser
# persistence and skips the Laravel API. Leave unset (or any other value)
# to route conductor calls through NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_CONDUCTOR_API_MODE=local
